# Application
APP_NAME="Meulah"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# HTTP
# Maximum request body size in bytes, including multipart uploads.
HTTP_MAX_BODY_SIZE=10485760

# Database
DB_DRIVER=sqlite
DB_PATH=data/database.sqlite

# MySQL alternative: replace the SQLite values above with these settings.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=meulah
# DB_USER=root
# DB_PASS=

# PostgreSQL alternative: replace the SQLite values above with these settings.
# DB_DRIVER=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=meulah
# DB_USER=postgres
# DB_PASS=

# Sessions
# Sessions are not enabled until the application registers SessionMiddleware.

# Security
# CSRF protection is configured when session and CSRF middleware are enabled.

# Files
UPLOAD_PATH=data/uploads
CACHE_PATH=runtime/cache
LOG_PATH=runtime/logs
SESSION_PATH=runtime/sessions
VIEW_CACHE_PATH=runtime/views
